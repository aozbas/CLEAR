# Path is relative to the project root unless absolute.
MODEL_PATH=ml/models/lesion_classifier_ham10000.pt
MODEL_VERSION=ham10000-resnet18-baseline-2026-05-18
MIN_PREDICTION_CONFIDENCE=0.60
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=25000000
PREDICTION_TIMEOUT_SECONDS=25
PREDICTION_QUEUE_TIMEOUT_SECONDS=0.25
MAX_CONCURRENT_PREDICTIONS=1
# Comma-separated exact origins. Do not use * for a public deployment.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Add the deployed API hostname before launch.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
